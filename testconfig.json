{
  "$schema": "https://raw.githubusercontent.com/microsoft/testfx/main/docs/testconfig.schema.json",
  "platformOptions": {
    "Coverlet": {
      "format": "cobertura",
      "excludeByFile": "**/*.g.cs",
      "exclude": "[System.Text.*]*,[Testcontainers*]*,[MySqlConnector*]*,[Docker.DotNet*]*,[*.Tests]*,[*.IntegrationTests]*,[*.Benchmarks]*,[TcfOss.DatabaseManager.Core*]*Errors.*",
      "excludeByAttribute": "ExcludeFromCodeCoverage,GeneratedCode",
      "skipAutoProps": true
    }
  }
}